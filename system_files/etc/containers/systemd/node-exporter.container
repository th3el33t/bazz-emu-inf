[Unit]
Description=Prometheus node_exporter (host metrics for the homelab)

[Container]
Image=docker.io/prom/node-exporter:v1.12.1
ContainerName=node-exporter
Network=host
Volume=/:/host:ro,rslave
Volume=/var/lib/node_exporter/textfile:/textfile:ro,z
# systemd collector: exports node_systemd_unit_state, which the homelab
# Prometheus rule SystemdUnitFailed watches and SystemdMetricsMissing guards.
# The reflash to this image dropped it (containerised node_exporter has no host
# systemd), so .40 exported zero unit metrics and SystemdMetricsMissing fired.
# The collector talks to systemd over its D-Bus PRIVATE socket at
# /run/systemd/private, so that dir is mounted in; SecurityLabelDisable lets the
# container connect to it under SELinux enforcing (acceptable — this container
# already ro-mounts all of / for host metrics). VALIDATE after the first boot on
# this image: `curl -s localhost:9100/metrics | grep -c node_systemd_unit_state`
# must be >0, and `systemctl --failed` on the host should match what Prometheus sees.
SecurityLabelDisable=true
Volume=/run/systemd:/run/systemd:ro
Exec=--path.rootfs=/host --collector.textfile.directory=/textfile --collector.systemd

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
