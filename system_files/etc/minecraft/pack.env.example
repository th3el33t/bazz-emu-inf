# Real pack selection lives on-box at /etc/minecraft/pack.env. These are
# itzg/minecraft-server's native names; do not add the old MC_ prefix.
TYPE=VANILLA
VERSION=LATEST
MEMORY=4G

# Modrinth example:
#TYPE=MODRINTH
#MODRINTH_MODPACK=https://modrinth.com/modpack/<slug>

# Auto CurseForge example:
#MODPACK_PLATFORM=AUTO_CURSEFORGE
#CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/<slug>
#CF_API_KEY=<required on images older than Java 17>

# Packwiz example (TYPE and VERSION must match pack.toml):
#TYPE=FABRIC
#VERSION=<minecraft version from pack.toml>
#PACKWIZ_URL=https://example.com/modpack/pack.toml
