[Unit]
Description=Minecraft server (itzg/minecraft-server, host net :25565)
After=bazz-minecraft-setup.service network-online.target

[Container]
Image=docker.io/itzg/minecraft-server:java25
ContainerName=minecraft
Network=host
Environment=EULA=TRUE TZ=America/Chicago SERVER_PORT=25565 USE_AIKAR_FLAGS=true ENABLE_AUTOPAUSE=FALSE MAX_PLAYERS=8 ENABLE_RCON=true
# Private runtime settings (RCON password) come from env; pack selection is
# isolated in pack.env so changing packs never touches secrets.
EnvironmentFile=/etc/minecraft/env
EnvironmentFile=/etc/minecraft/pack.env
Volume=/var/lib/minecraft/data:/data:Z
Volume=/var/lib/minecraft/modpacks:/modpacks:Z

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
