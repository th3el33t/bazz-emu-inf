# Real env lives on-box at /etc/minecraft/env (root-only; secrets never in the
# image). bazz-minecraft-setup generates it with a random RCON_PASSWORD on first
# boot. This file documents the shape.

# Generated automatically at first boot:
RCON_PASSWORD=<random hex>

# Owner-supplied: playit.gg docker-agent secret, then `systemctl start playit`
# (https://playit.gg/account/agents/new-docker). Blank = playit refuses to start
# by design (ExecStartPre guard), LAN play on :25565 is unaffected.
PLAYIT_SECRET_KEY=

# Pack selection (leave all unset for the vanilla default; see homelab
# services/minecraft/SWAP-PACKS.md for the three keyless lanes):
#MC_TYPE=MODRINTH
#MODRINTH_MODPACK=https://modrinth.com/modpack/<slug>
#MC_TYPE=FTBA
#FTB_MODPACK_ID=123
#FTB_MODPACK_VERSION_ID=456
#MC_TYPE=CURSEFORGE
#CF_SERVER_MOD=/modpacks/<ServerPack>.zip
#MC_MEMORY=12G
