# Parameters for the image build.

# Output image name — must match the repo name (published as ghcr.io/<org>/<name>).
IMAGE_NAME=bazz-emu-inf

# GitHub username/organisation that owns the repo + GHCR package.
REPO_ORGANIZATION="th3el33t"

IMAGE_DESC="Bazzite (NVIDIA open) + emulation + local inference — custom bootc image for WaterDemon (RTX 4090)"
IMAGE_KEYWORDS="bootc,oci,bazzite,nvidia,emulation,inference,gaming"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
