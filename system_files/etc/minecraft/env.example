# Private runtime env lives on-box at /etc/minecraft/env (root-only; secrets
# never in the image). Pack selection belongs in /etc/minecraft/pack.env.

# Generated automatically at first boot:
RCON_PASSWORD=<random hex>

# Owner-supplied: playit.gg docker-agent secret, then `systemctl start playit`
# (https://playit.gg/account/agents/new-docker). Blank = playit refuses to start
# by design (ExecStartPre guard), LAN play on :25565 is unaffected.
PLAYIT_SECRET_KEY=
