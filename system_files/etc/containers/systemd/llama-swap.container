[Unit]
Description=llama-swap: on-demand Qwen3-Coder-30B-A3B on the RTX 4090 (port 8085)
After=bazz-llama-models.service network-online.target
Wants=network-online.target

[Container]
# llama-swap cuda image = ggml llama.cpp server-cuda (b10689 here) + llama-swap,
# so llama-server is bundled at /app. Digest-pinned (2026-08-30 build).
Image=ghcr.io/mostlygeek/llama-swap:cuda@sha256:fadd77f5b93b2347ca57fc940aa63dcdada011888e2fdb1722112a87eb8ebf95
ContainerName=llama-swap
Network=host
AddDevice=nvidia.com/gpu=all
# gpu-busy.sh must see host processes and TCP connections from inside the
# container; without --pid=host the wake gate would fail open.
PodmanArgs=--pid=host
# The image's entrypoint already passes -config /app/config.yaml -watch-config;
# overriding Exec appends flags and Go keeps the FIRST -config, so instead we
# bind our config over /app/config.yaml. Config is read at startup — after
# editing /etc/llama-swap/config.yaml on the host, systemctl restart llama-swap
# (the restart re-binds the file, so a host-side edit that replaced the inode
# is picked up too).
Volume=/etc/llama-swap/config.yaml:/app/config.yaml:ro
Volume=/var/lib/llama-models:/models:ro
Volume=/usr/libexec/bazz-llama:/usr/libexec/bazz-llama:ro
# listen is a CLI-only flag (the YAML schema has no key for it); Exec appends
# to the image entrypoint, and all three flags coexist fine.
Exec=-listen :8085
# The upstream image bakes a HEALTHCHECK that curls :8080 — the on-demand UPSTREAM
# llama-server, which is DOWN whenever no model is loaded. So the container reads
# "unhealthy" the whole time it sits idle, and its transient podman-healthcheck unit
# trips the fleet SystemdUnitFailed rule for a service that is actually fine. Point
# the check at llama-swap's OWN listener (:8085/health), which returns 200 even with
# no model loaded. Verified 2026-09-01.
HealthCmd=curl -f http://localhost:8085/health

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
