[Unit]
Description=bazz-emu-inf first-boot emulation Flatpak install
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/bazz-emu-inf/flatpaks-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/bazz-first-boot-flatpaks.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
